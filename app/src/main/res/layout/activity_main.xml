<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp"
            android:minHeight="?attr/actionBarSize" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ════════════════════════════════════════════════════════
                 App List View
                 ════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutAppList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSpaceFilter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBatchMode"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_gravity="top"
                        android:text="@string/batch_manage"
                        app:chipIcon="@android:drawable/ic_menu_agenda" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/appsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvApps"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="80dp" />

                    <!-- Shimmer overlay -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmerOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:clipToPadding="false"
                        android:paddingBottom="80dp"
                        app:shimmer_auto_start="false">

                        <!-- Populated at runtime with just enough rows to cover the screen; see populateSkeletonList() -->
                        <LinearLayout
                            android:id="@+id/skeletonList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <!-- Batch-selection action FAB -->
                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/fabBatchActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="96dp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_edit"
                        app:iconTint="?attr/colorOnSurfaceVariant"
                        tools:text="3 selected" />

                </FrameLayout>

            </LinearLayout>

            <!-- ════════════════════════════════════════════════════════
                 Settings View
                 ════════════════════════════════════════════════════════ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/layoutSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:paddingBottom="80dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ── About card ───────────────────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_about"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?android:textColorPrimary" />

                            <TextView
                                android:id="@+id/tvAppVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_name_version"
                                android:textSize="14sp"
                                android:textColor="?android:textColorSecondary"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_AppDualZuku"
                                android:textSize="12sp"
                                android:textColor="?android:textColorSecondary"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ── Execution mode card ─────────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardExecutionMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/execution_mode"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?android:textColorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/execution_mode_description"
                                android:textSize="12sp"
                                android:textColor="?android:textColorSecondary"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/use_root_switch"
                                        android:textSize="14sp"
                                        android:textColor="?android:textColorPrimary" />

                                    <TextView
                                        android:id="@+id/tvRootStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/root_checking"
                                        android:textSize="11sp"
                                        android:textColor="?android:textColorSecondary" />

                                </LinearLayout>

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/switchUseRoot"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ── Managed Workspaces card ──────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Header + subtitle -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/managed_workspaces"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?android:textColorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/workspaces_description"
                                android:textSize="12sp"
                                android:textColor="?android:textColorSecondary"
                                android:layout_marginTop="4dp" />

                            <!-- Difference Notice -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/workspaces_notice"
                                android:textSize="11sp"
                                android:textColor="?android:textColorSecondary"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="12dp" />

                            <!-- Create + Refresh buttons -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCreateWorkspace"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/create_workspace"
                                    app:icon="@android:drawable/ic_input_add"
                                    style="@style/Widget.Material3.Button.TonalButton" />

                                <Space android:layout_width="4dp" android:layout_height="1dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCreateCloneWorkspace"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/create_clone_workspace"
                                    app:icon="@android:drawable/ic_input_add"
                                    style="@style/Widget.Material3.Button.TonalButton" />

                                <Space android:layout_width="4dp" android:layout_height="1dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRefreshWorkspaces"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/refresh"
                                    style="@style/Widget.Material3.Button.TextButton" />

                            </LinearLayout>

                            <!-- Workspace list (nested inside card, non-scrollable RV) -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvWorkspaces"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never" />

                            <!-- Empty state -->
                            <TextView
                                android:id="@+id/tvNoWorkspacesInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/no_workspaces_info"
                                android:textAlignment="center"
                                android:textColor="?android:textColorSecondary"
                                android:textSize="13sp"
                                android:padding="16dp"
                                android:visibility="gone" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ── Hidden Developer Panel ───────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDevPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:cardElevation="1dp"
                        app:strokeColor="?attr/colorError"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_console"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorError"
                                android:layout_marginBottom="12dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/dev_cmd_hint"
                                app:boxBackgroundMode="outline"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etDevCmd"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:fontFamily="monospace" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDevRun"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/dev_run"
                                    style="@style/Widget.Material3.Button.TonalButton" />

                                <Space android:layout_width="8dp" android:layout_height="1dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDevClear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dev_clear"
                                    style="@style/Widget.Material3.Button.TextButton" />

                            </LinearLayout>

                            <!-- Output area -->
                            <androidx.core.widget.NestedScrollView
                                android:id="@+id/scrollDevOutput"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:layout_marginTop="12dp"
                                android:background="?attr/colorSurfaceVariant"
                                android:padding="1dp">

                                <TextView
                                    android:id="@+id/tvDevOutput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:textSize="12sp"
                                    android:padding="8dp"
                                    android:textIsSelectable="true"
                                    android:textColor="?android:textColorPrimary"
                                    android:text="@string/dev_output_hint" />

                            </androidx.core.widget.NestedScrollView>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        app:menu="@menu/menu_bottom_nav"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
